# =============================================================================
# WeatherGPT Environment Configuration
# Copy this file to backend/.env and paste your API keys below
# =============================================================================

# ── 1. LLM Provider (Google Gemini or OpenAI) ────────────────────────────────
# Get free key from: https://aistudio.google.com/app/apikey
LLM_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 2. Weather APIs ──────────────────────────────────────────────────────────
# OpenWeather One Call 3.0 (Free tier): https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Mapbox GL Access Token (Free tier): https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# IMD Gateway (Optional / National data.gov.in key)
IMD_API_BASE=https://api.imd.gov.in/api/v1
IMD_API_KEY=

# RainViewer Radar (Enabled by default - 100% free open cache)
RAINVIEWER_ENABLED=true
USE_FIXTURE_WEATHER=false

# ── 3. Bhashini Indic Speech & Translation (MeitY Govt of India) ──────────────
# Register & generate from: https://bhashini.gov.in/ulca/user/login
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── 4. Supabase PostgreSQL (Cloud Database) ──────────────────────────────────
# Create free project at: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Format: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ── 5. Server Runtime ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
